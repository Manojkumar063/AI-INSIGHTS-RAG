rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: documents
    // Fields:
    //   - name: string (1-255 chars) - File name
    //   - content: string (up to 1MB) - Extracted text content
    //   - userId: string - UID of the owner
    //   - size: number - File size
    //   - type: string - MIME type
    //   - createdAt: timestamp - Creation time
    //
    // Collection: documents/{docId}/messages
    // Fields:
    //   - text: string (1-5000 chars)
    //   - role: string (enum: 'user', 'assistant')
    //   - createdAt: timestamp
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner(docId) {
      return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/documents/$(docId)).data.userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "manojkumargowd063@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['name', 'content', 'userId', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 255 &&
             data.content is string && data.content.size() > 0 &&
             data.userId == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'role', 'createdAt']) &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 10000 &&
             data.role in ['user', 'assistant'] &&
             data.createdAt is timestamp;
    }

    // Rules for documents collection
    match /documents/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isValidDocument(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isValidDocument(request.resource.data) && 
                      request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId) || isAdmin();

      // Subcollection for messages (chat history for a specific doc context)
      match /messages/{msgId} {
        allow read: if isDocOwner(docId) || isAdmin();
        allow create: if isDocOwner(docId) && isValidMessage(request.resource.data);
        allow delete: if isDocOwner(docId) || isAdmin();
      }
    }

    // User profile section (optional but good practice)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }
  }
}
