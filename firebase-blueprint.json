{
  "entities": {
    "Document": {
      "title": "Document",
      "description": "Metadata and content of an uploaded document.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "File name" },
        "content": { "type": "string", "description": "Extracted text content" },
        "userId": { "type": "string", "description": "UID of the owner" },
        "size": { "type": "number", "description": "File size in bytes" },
        "type": { "type": "string", "description": "MIME type" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "content", "userId", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a conversation.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "The message content" },
        "role": { "type": "string", "enum": ["user", "assistant"], "description": "Who sent the message" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "role", "createdAt"]
    }
  },
  "firestore": {
    "/documents/{docId}": {
      "schema": "Document",
      "description": "Collection of uploaded documents."
    },
    "/documents/{docId}/messages/{msgId}": {
      "schema": "Message",
      "description": "Messages associated with a specific document context."
    }
  }
}
